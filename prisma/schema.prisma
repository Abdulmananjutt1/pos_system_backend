// PharmaPOS — Prisma Schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  admin
  cashier
}

enum MedicineCategory {
  Tablet
  Capsule
  Syrup
  Injection
  Cream
  Drops
  Inhaler
  Supplement
  Other
}

enum PaymentMethod {
  Cash
  Card
  UBL
  JazzCash
  EasyPaisa
}

enum SaleStatus {
  Completed
  Pending
  Refunded
}

enum ReceiptTemplate {
  thermal
  a4
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(cashier)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  sales Sale[]

  @@map("users")
}

model Medicine {
  id                   String           @id @default(uuid())
  name                 String
  genericName          String           @default("") @map("generic_name")
  brand                String           @default("")
  category             MedicineCategory @default(Other)
  batchNumber          String           @default("") @map("batch_number")
  expiryDate           DateTime         @map("expiry_date")
  purchasePrice        Decimal          @default(0) @db.Decimal(10, 2) @map("purchase_price")
  sellingPrice         Decimal          @default(0) @db.Decimal(10, 2) @map("selling_price")
  stock                Int              @default(0)
  minStock             Int              @default(10) @map("min_stock")
  unit                 String           @default("Pcs")
  description          String?
  requiresPrescription Boolean          @default(false) @map("requires_prescription")
  createdAt            DateTime         @default(now()) @map("created_at")
  updatedAt            DateTime         @updatedAt @map("updated_at")

  supplierId String?   @map("supplier_id")
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  saleItems          SaleItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockTransferItems StockTransferItem[]
  returnItems        SaleReturnItem[]

  @@index([name])
  @@index([category])
  @@index([expiryDate])
  @@index([stock])
  @@map("medicines")
}

model Customer {
  id             String   @id @default(uuid())
  name           String
  phone          String
  email          String?
  address        String?
  totalPurchases Decimal  @default(0) @db.Decimal(12, 2) @map("total_purchases")
  createdAt      DateTime @default(now()) @map("created_at")

  sales Sale[]

  @@index([phone])
  @@map("customers")
}

model Supplier {
  id            String   @id @default(uuid())
  name          String
  contactPerson String   @default("") @map("contact_person")
  phone         String
  email         String?
  address       String   @default("")
  createdAt     DateTime @default(now()) @map("created_at")

  medicines      Medicine[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Sale {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique @map("invoice_number")
  customerName  String        @default("Walk-in Customer") @map("customer_name")
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  tax           Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  paymentMethod PaymentMethod @default(Cash) @map("payment_method")
  status        SaleStatus    @default(Completed)
  cashierName   String        @default("") @map("cashier_name")
  createdAt     DateTime      @default(now()) @map("created_at")

  customerId String?   @map("customer_id")
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  cashierId String @map("cashier_id")
  cashier   User   @relation(fields: [cashierId], references: [id])

  items SaleItem[]
  returns SaleReturn[]
  @@index([customerId])
  @@index([invoiceNumber])
  @@map("sales")
}

model SaleItem {
  id           String  @id @default(uuid())
  medicineName String  @map("medicine_name")
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2) @map("unit_price")
  discount     Decimal @default(0) @db.Decimal(5, 2)
  total        Decimal @db.Decimal(12, 2)

  saleId String @map("sale_id")
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  medicineId String   @map("medicine_id")
  medicine   Medicine @relation(fields: [medicineId], references: [id])

  @@index([saleId])
  @@map("sale_items")
}

enum POStatus {
  Draft
  Sent
  Confirmed
  PartiallyReceived
  Received
  Cancelled
}

model PurchaseOrder {
  id                   String    @id @default(uuid())
  poNumber             String    @unique @map("po_number")
  supplierId           String?   @map("supplier_id")
  supplier             Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName         String    @default("") @map("supplier_name")
  poDate               DateTime  @default(now()) @map("po_date") @db.Date
  expectedDeliveryDate DateTime? @map("expected_delivery_date") @db.Date
  status               POStatus  @default(Draft)
  totalAmount          Decimal   @default(0) @db.Decimal(12, 2) @map("total_amount")
  notes                String?
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  items PurchaseOrderItem[]

  @@index([status])
  @@index([poDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id               String  @id @default(uuid())
  medicineName     String  @map("medicine_name")
  quantity         Int     @default(1)
  unitPrice        Decimal @db.Decimal(10, 2) @map("unit_price")
  receivedQuantity Int     @default(0) @map("received_quantity")
  total            Decimal @db.Decimal(12, 2)
  batchNumber      String? @map("batch_number")
  expiryDate       DateTime? @map("expiry_date") @db.Date

  purchaseOrderId String        @map("purchase_order_id")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  medicineId String?   @map("medicine_id")
  medicine   Medicine? @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

enum TransferStatus {
  Pending
  InTransit
  Received
  Rejected
}

enum TransferType {
  Internal
  ExternalOut
  ExternalIn
}

model StockTransfer {
  id               String         @id @default(uuid())
  transferNumber   String         @unique @map("transfer_number")
  transferType     TransferType   @default(Internal) @map("transfer_type")
  fromBranch       String         @map("from_branch")
  toBranch         String         @map("to_branch")
  externalPharmacy String?        @map("external_pharmacy")
  externalPhone    String?        @map("external_phone")
  transferDate     DateTime       @default(now()) @map("transfer_date") @db.Date
  receiveDate      DateTime?      @map("receive_date") @db.Date
  status           TransferStatus @default(Pending)
  notes            String?
  initiatedBy      String         @default("") @map("initiated_by")
  createdAt        DateTime       @default(now()) @map("created_at")

  items StockTransferItem[]

  @@index([status])
  @@index([transferDate])
  @@index([transferType])
  @@map("stock_transfers")
}

model StockTransferItem {
  id           String @id @default(uuid())
  medicineName String @map("medicine_name")
  quantity     Int    @default(1)
  batchNumber  String? @map("batch_number")
  expiryDate   DateTime? @map("expiry_date") @db.Date

  transferId String        @map("transfer_id")
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  medicineId String?   @map("medicine_id")
  medicine   Medicine? @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([transferId])
  @@map("stock_transfer_items")
}

enum ReturnStatus {
  Approved
  Rejected
  Partial
}

enum ReturnReason {
  Defective
  Expired
  WrongItem
  CustomerRequest
  Other
}

enum ReturnCondition {
  Good
  Opened
  Damaged
  Expired
}

model SaleReturn {
  id           String       @id @default(uuid())
  returnNumber String       @unique @map("return_number")
  invoiceNumber String      @map("invoice_number")
  returnDate   DateTime     @default(now()) @map("return_date") @db.Date
  reason       String       @default("")
  notes        String?
  refundAmount Decimal      @db.Decimal(12, 2) @map("refund_amount")
  refundMethod String       @default("Cash") @map("refund_method")
  status       ReturnStatus @default(Approved)
  createdAt    DateTime     @default(now()) @map("created_at")

  saleId String @map("sale_id")
  sale   Sale   @relation(fields: [saleId], references: [id])

  items SaleReturnItem[]

  @@index([saleId])
  @@index([returnDate])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String          @id @default(uuid())
  medicineName String          @map("medicine_name")
  saleQuantity Int             @map("sale_quantity")
  returnQuantity Int           @map("return_quantity")
  unitPrice    Decimal         @db.Decimal(10, 2) @map("unit_price")
  reason       ReturnReason    @default(CustomerRequest)
  condition    ReturnCondition @default(Good)

  returnId String     @map("return_id")
  saleReturn SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  medicineId String?   @map("medicine_id")
  medicine   Medicine? @relation(fields: [medicineId], references: [id], onDelete: SetNull)

  @@index([returnId])
  @@map("sale_return_items")
}

enum ShiftStatus {
  Open
  Closed
}

model CashShift {
  id             String      @id @default(uuid())
  shiftNumber    String      @unique @map("shift_number")
  openedBy       String      @map("opened_by")
  closedBy       String?     @map("closed_by")
  openTime       DateTime    @default(now()) @map("open_time")
  closeTime      DateTime?   @map("close_time")
  openingBalance Decimal     @default(0) @db.Decimal(12, 2) @map("opening_balance")
  closingBalance Decimal?    @db.Decimal(12, 2) @map("closing_balance")
  expectedCash   Decimal?    @db.Decimal(12, 2) @map("expected_cash")
  variance       Decimal?    @db.Decimal(12, 2)
  status         ShiftStatus @default(Open)
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")

  entries CashShiftEntry[]

  @@index([status])
  @@map("cash_shifts")
}

model CashShiftEntry {
  id          String   @id @default(uuid())
  description String
  amount      Decimal  @db.Decimal(12, 2)
  type        String   @default("in") // "in" | "out"
  createdAt   DateTime @default(now()) @map("created_at")

  shiftId String     @map("shift_id")
  shift   CashShift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
  @@map("cash_shift_entries")
}

model Expense {
  id          String   @id @default(uuid())
  description String
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @default("Other")
  date        DateTime @db.Date
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("expenses")
}

model AppSettings {
  id                 Int             @id @default(1)
  pharmacyName       String          @default("My Pharmacy") @map("pharmacy_name")
  address            String          @default("")
  phone              String          @default("")
  taxRate            Decimal         @default(0) @db.Decimal(5, 4) @map("tax_rate")
  invoicePrefix      String          @default("INV") @map("invoice_prefix")
  currency           String          @default("PKR")
  lowStockThreshold  Int             @default(10) @map("low_stock_threshold")
  receiptTemplate    ReceiptTemplate @default(thermal) @map("receipt_template")
  allowLineDiscount  Boolean         @default(true) @map("allow_line_discount")
  allowBillDiscount  Boolean         @default(true) @map("allow_bill_discount")
  allowSplitPayment  Boolean         @default(true) @map("allow_split_payment")
  allowHoldSale      Boolean         @default(true) @map("allow_hold_sale")

  @@map("app_settings")
}
